# Copy to .env and adjust as needed: `cp .env.example .env`.
# docker compose automatically loads .env from this directory.
# All values have sane defaults baked into docker-compose.yml — everything here
# is optional.

# Host port the Overpass API is published on (container always serves on 80).
#   Endpoints: http://localhost:${OVERPASS_PORT}/api/interpreter
#              http://localhost:${OVERPASS_PORT}/api/status
OVERPASS_PORT=12345

# --- Region source -----------------------------------------------------------
# Defaults target the Geofabrik California extract + its diff feed. To self-host
# a different region, override BOTH to a matching Geofabrik pair, e.g.:
#   OVERPASS_PLANET_URL=https://download.geofabrik.de/north-america/us/nevada-latest.osm.pbf
#   OVERPASS_DIFF_URL=https://download.geofabrik.de/north-america/us/nevada-updates/
#OVERPASS_PLANET_URL=https://download.geofabrik.de/north-america/us/california-latest.osm.pbf
#OVERPASS_DIFF_URL=https://download.geofabrik.de/north-america/us/california-updates/

# --- Tuning ------------------------------------------------------------------
# Seconds between diff polls. Default is every 12 hours (43200). Each poll
# applies every Geofabrik diff published since the last run, so the data ends up
# current regardless of cadence — a shorter interval just narrows the staleness
# window.
OVERPASS_UPDATE_SLEEP=43200

# Dispatcher scratch space for query results, in bytes (default 2 GiB).
OVERPASS_SPACE=2147483648

# Server-side max query runtime advertised to clients, in seconds.
OVERPASS_MAX_TIMEOUT=1000
